#
# Shell scripts must keep LF endings even when checked out on Windows: the
# Windows workflow runs deploy/wsl-zfs/build.sh and the guest-side scripts inside
# WSL, and a CRLF shebang fails there with a bare "not found".
*.sh            text eol=lf
Dockerfile      text eol=lf
Makefile        text eol=lf

# PowerShell is Windows-native; CRLF is its convention.
*.ps1           text eol=crlf

# Go tooling is LF-only (gofmt reports CRLF files as unformatted).
*.go            text eol=lf
go.mod          text eol=lf
go.sum          text eol=lf

# SQL is embedded into the fox binary and run by psql inside Linux containers;
# keep it LF so every platform builds the same bytes.
*.sql           text eol=lf

# Workflow `run:` blocks execute on Linux runners; CRLF there breaks the shell.
*.yml text eol=lf
*.yaml text eol=lf
