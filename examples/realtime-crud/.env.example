# Account key: SQL through the gateway. From `fox apikey create <email> todos`.
FOX_API_KEY=key_...

# Stream-only key: the browser subscribes with this and can do nothing else.
# From `fox realtime key create <branch> --name todos`.
FOX_REALTIME_KEY=rtk_...

# Branch this process serves. One process, one branch, one realtime key.
FOX_BRANCH=main

# Where this UI listens, and where FoxByte is (defaults match a local install).
PORT=8787
FOX_API=https://127.0.0.1:8080
FOX_GATEWAY_HOST=127.0.0.1
FOX_GATEWAY_PORT=6432
FOX_DB_USER=dbadmin
